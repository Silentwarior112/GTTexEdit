<?xml version="1.0" encoding="utf-8"?>
<!-- One small framework-dependent GTTexEdit.exe: needs the .NET 10 Desktop Runtime on the target machine.
     dotnet publish src\GTTexEdit\GTTexEdit.csproj -c Release -p:PublishProfile=win-x64-framework -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>bin\publish\win-x64-framework\</PublishDir>
  </PropertyGroup>
</Project>
