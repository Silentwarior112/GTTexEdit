<?xml version="1.0" encoding="utf-8"?>
<!-- One self-contained GTTexEdit.exe: needs nothing installed on the target machine.
     dotnet publish src\GTTexEdit\GTTexEdit.csproj -c Release -p:PublishProfile=win-x64-selfcontained -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>bin\publish\win-x64-selfcontained\</PublishDir>
  </PropertyGroup>
</Project>
